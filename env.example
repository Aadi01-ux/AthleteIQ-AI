# ─────────────────────────────────────────────────────────────────────────────
# AthleteIQ AI – Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Your Groq API key.
# Get a free key at https://console.groq.com/keys
# Without this key the app runs in Demo Mode with rule-based AI responses.
GROQ_API_KEY=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

# Groq model to use.
# Available models (as of 2024):
#   llama3-8b-8192     – Fast, great for most tasks (default)
#   llama3-70b-8192    – More capable, slower
#   mixtral-8x7b-32768 – Larger context window
#   gemma-7b-it        – Google Gemma
GROQ_MODEL=qwen/qwen3.8-27b

# SQLite database file path (relative to app.py)
DB_PATH=athleteiq.db

# Sample CSV data file path (relative to app.py)
CSV_PATH=athletes.csv
